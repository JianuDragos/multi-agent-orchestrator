import json
from pathlib import Path

from tools.ollama_client import OllamaClient
from tools.project_scan import build_project_tree, collect_relevant_files, read_file_safe
from tools.plan_validation import (
    normalize_list,
    validate_coordinator_plan,
    validate_supervisor_plan,
)


IGNORED_DIRS = {".git", ".venv", "__pycache__", "node_modules", "runs", "memory"}


def extract_json(raw_text: str) -> str:
    if not raw_text or not raw_text.strip():
        raise ValueError("Empty model output")

    lines = []
    for line in raw_text.splitlines():
        if line.strip().startswith("```"):
            continue
        lines.append(line)

    text = "\n".join(lines).strip()

    decoder = json.JSONDecoder()
    found = []

    for i, ch in enumerate(text):
        if ch != "{":
            continue
        try:
            obj, _ = decoder.raw_decode(text[i:])
            if isinstance(obj, dict):
                found.append(obj)
        except json.JSONDecodeError:
            continue

    if not found:
        raise ValueError(f"No valid JSON object found in model output:\n{text}")

    return json.dumps(found[-1], ensure_ascii=False)


def keyword_guess(task: str):
    words = []
    raw = task.lower().replace("-", " ").replace("/", " ").split()

    for w in raw:
        w = w.strip(".,:;!?()[]{}\"'")
        if len(w) >= 3:
            words.append(w)

    extra = []
    lowered = task.lower()

    if "ui" in lowered or "frontend" in lowered or "button" in lowered:
        extra += ["html", "js", "css", "template"]
    if "api" in lowered or "backend" in lowered or "route" in lowered:
        extra += ["py", "routes", "api", "server"]
    if "database" in lowered or "db" in lowered:
        extra += ["db", "database", "models", "sql"]

    return list(dict.fromkeys(words + extra))


def list_all_project_files(root: Path):
    files = []
    for path in root.rglob("*"):
        if path.is_file():
            if any(part in IGNORED_DIRS for part in path.parts):
                continue
            files.append(str(path.relative_to(root)))
    return sorted(files)


def main():
    client = OllamaClient()

    print("=== Multi-Agent Orchestrator ===")
    project_path = input("Enter project path: ").strip()
    task = input("Enter task: ").strip()

    if not project_path:
        print("No project path provided.")
        return

    if not task:
        print("No task provided.")
        return

    root = Path(project_path).resolve()
    if not root.exists():
        print(f"Project path does not exist: {root}")
        return

    print("\n[Context] Building project tree...")
    tree = build_project_tree(str(root))
    real_files = list_all_project_files(root)

    keywords = keyword_guess(task)
    relevant_files = collect_relevant_files(str(root), keywords=keywords, max_files=8)

    print("\n=== Relevant files selected ===")
    for f in relevant_files:
        print("-", f.relative_to(root))

    file_blocks = []
    for path in relevant_files:
        rel = path.relative_to(root)
        content = read_file_safe(path)
        file_blocks.append(f"=== FILE: {rel} ===\n{content}")

    relevant_context = "\n\n".join(file_blocks)
    real_files_text = "\n".join(real_files)
    relevant_file_names = [str(f.relative_to(root)) for f in relevant_files]

    coordinator_prompt = f"""
You are the coordinator in a multi-agent coding system.

Project root:
{root}

Task:
{task}

Project tree:
{tree}

All real project files:
{real_files_text}

Relevant files:
{relevant_context}

Return ONLY valid JSON with this exact schema:
{{
  "task_type": "code or ui or mixed",
  "probable_cause": "short text",
  "files_to_modify": ["real/project/file1", "real/project/file2"],
  "files_to_avoid": ["real/project/file3"],
  "steps": ["step1", "step2", "step3"],
  "risks": ["risk1", "risk2"]
}}

Rules:
- Use ONLY real file paths that exist in 'All real project files'.
- Do not invent filenames.
- Stay strictly on the requested task.
- Prefer minimal safe changes.
- Every schema field is required.
- files_to_avoid may be [] if nothing should be avoided.
""".strip()

    print("\n[1/2] Asking coordinator...")
    coordinator_raw = client.generate("coordinator", coordinator_prompt)

    print("\n=== Coordinator raw response ===")
    print(coordinator_raw)

    try:
        coordinator_clean = extract_json(coordinator_raw)
    except ValueError as e:
        print("\nCoordinator output could not be cleaned into JSON.")
        print(e)
        return

    print("\n=== Coordinator cleaned response ===")
    print(coordinator_clean)

    try:
        coordinator_plan = json.loads(coordinator_clean)
    except json.JSONDecodeError as e:
        print("\nCoordinator did not return valid JSON.")
        print(f"JSON error: {e}")
        return

    print("\n=== Coordinator parsed JSON ===")
    print(json.dumps(coordinator_plan, indent=2, ensure_ascii=False))

    coordinator_validation_problems = validate_coordinator_plan(coordinator_plan, real_files)

    print("\n=== Coordinator validation ===")
    if coordinator_validation_problems:
        for p in coordinator_validation_problems:
            print("-", p)
    else:
        print("No coordinator validation problems detected.")

    supervisor_prompt = f"""
You are the supervisor in a multi-agent coding system.

Your job is to review the coordinator plan, correct it if needed, and return exactly one JSON object.

Task:
{task}

Relevant real files:
{json.dumps(relevant_file_names, ensure_ascii=False)}

Coordinator plan:
{json.dumps(coordinator_plan, ensure_ascii=False)}

Coordinator validation problems:
{json.dumps(coordinator_validation_problems, ensure_ascii=False)}

Return exactly one valid JSON object with this exact schema:
{{
  "approved": true,
  "worker": "code or ui",
  "reason": "short text",
  "files_to_modify": ["real/project/file1", "real/project/file2"],
  "files_to_avoid": ["real/project/file3"],
  "constraints": ["constraint1", "constraint2"],
  "corrected_steps": ["step1", "step2", "step3"]
}}

Hard rules:
- Output JSON only.
- Do not output markdown.
- Do not use code fences.
- Do not output explanations.
- Do not output analysis.
- Do not output thinking.
- Do not write any text before the opening {{.
- Do not write any text after the closing }}.
- The response must start with {{ and end with }}.
- Use ONLY file paths from this list: {json.dumps(relevant_file_names, ensure_ascii=False)}
- Prefer minimal safe changes.
- Reject invented paths.
- Reject unnecessarily broad changes.
- Every schema field is required.
- Always include "constraints"; use [] if there are no constraints.
- "approved" means whether your FINAL supervisor plan is safe to execute.
- If you corrected the coordinator plan and your corrected plan is safe, set "approved" to true.
- Set "approved" to false only if execution should stop and a new planning pass is required.
""".strip()

    print("\n[2/2] Asking supervisor...")
    supervisor_raw = client.generate("supervisor", supervisor_prompt)

    print("\n=== Supervisor raw response ===")
    print(supervisor_raw)

    try:
        supervisor_clean = extract_json(supervisor_raw)
    except ValueError as e:
        print("\nSupervisor output could not be cleaned into JSON.")
        print(e)
        return

    print("\n=== Supervisor cleaned response ===")
    print(supervisor_clean)

    try:
        supervisor_plan = json.loads(supervisor_clean)
    except json.JSONDecodeError as e:
        print("\nSupervisor did not return valid JSON.")
        print(f"JSON error: {e}")
        return

    print("\n=== Supervisor parsed JSON ===")
    print(json.dumps(supervisor_plan, indent=2, ensure_ascii=False))

    supervisor_validation_problems = validate_supervisor_plan(supervisor_plan, real_files)

    print("\n=== Supervisor validation ===")
    if supervisor_validation_problems:
        for p in supervisor_validation_problems:
            print("-", p)
        print("Stopping before worker routing.")
        return
    else:
        print("No supervisor validation problems detected.")

    approved = bool(supervisor_plan.get("approved", False))
    if not approved:
        print("\nSupervisor did not approve a final executable plan.")
        print("Stopping before worker routing.")
        return

    constraints = normalize_list(supervisor_plan.get("constraints", []))
    worker_type = str(supervisor_plan.get("worker", "")).strip().lower()

    if worker_type == "code":
        selected_worker_role = "code_worker"
    elif worker_type == "ui":
        selected_worker_role = "ui_worker"
    else:
        print("\nUnknown worker type returned by supervisor.")
        print(f"worker={worker_type!r}")
        return

    worker_request = {
        "task": task,
        "worker": worker_type,
        "selected_worker_role": selected_worker_role,
        "files_to_modify": normalize_list(supervisor_plan.get("files_to_modify", [])),
        "files_to_avoid": normalize_list(supervisor_plan.get("files_to_avoid", [])),
        "constraints": constraints,
        "steps": normalize_list(supervisor_plan.get("corrected_steps", []))
    }

    print("\n=== Worker routing ===")
    print(f"Selected worker type: {worker_type}")
    print(f"Selected worker role: {selected_worker_role}")

    print("\n=== Worker request preview ===")
    print(json.dumps(worker_request, indent=2, ensure_ascii=False))


if __name__ == "__main__":
    main()
