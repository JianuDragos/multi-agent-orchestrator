from pathlib import Path


IGNORED_DIRS = {
    ".git",
    ".venv",
    "__pycache__",
    "node_modules",
    "runs",
    "memory"
}


def build_project_tree(root: str, max_depth: int = 4) -> str:
    root_path = Path(root).resolve()
    lines = []

    def walk(path: Path, prefix: str = "", depth: int = 0):
        if depth > max_depth:
            return

        try:
            entries = sorted(
                [p for p in path.iterdir() if p.name not in IGNORED_DIRS],
                key=lambda p: (p.is_file(), p.name.lower())
            )
        except PermissionError:
            return

        for entry in entries:
            rel = entry.relative_to(root_path)
            lines.append(f"{prefix}{rel}")
            if entry.is_dir():
                walk(entry, prefix="", depth=depth + 1)

    walk(root_path)
    return "\n".join(lines)


def read_file_safe(path: Path, max_chars: int = 12000) -> str:
    try:
        content = path.read_text(encoding="utf-8", errors="ignore")
    except Exception as e:
        return f"[Could not read file: {e}]"

    if len(content) > max_chars:
        content = content[:max_chars] + "\n...[truncated]"

    return content


def collect_relevant_files(root: str, keywords=None, max_files: int = 8):
    if keywords is None:
        keywords = []

    root_path = Path(root).resolve()
    candidates = []

    for path in root_path.rglob("*"):
        if any(part in IGNORED_DIRS for part in path.parts):
            continue
        if path.is_file():
            score = 0
            name = path.name.lower()
            full = str(path.relative_to(root_path)).lower()

            for kw in keywords:
                kw = kw.lower()
                if kw in name:
                    score += 3
                if kw in full:
                    score += 2

            if score > 0:
                candidates.append((score, path))

    candidates.sort(key=lambda x: (-x[0], str(x[1])))

    unique = []
    seen = set()
    for _, path in candidates:
        rel = str(path.relative_to(root_path))
        if rel not in seen:
            seen.add(rel)
            unique.append(path)
        if len(unique) >= max_files:
            break

    return unique
