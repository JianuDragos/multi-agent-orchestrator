from pathlib import Path
import re


IGNORED_DIRS = {
    ".git",
    ".venv",
    "__pycache__",
    "node_modules",
    "runs",
    "memory"
}


def build_project_tree(root: str, max_depth: int = 4) -> str:
    root_path = Path(root).resolve()
    lines = [root_path.name + "/"]

    def walk(path: Path, prefix: str = "", depth: int = 0):
        if depth >= max_depth:
            return

        try:
            entries = sorted(
                [p for p in path.iterdir() if p.name not in IGNORED_DIRS],
                key=lambda p: (not p.is_dir(), p.name.lower())
            )
        except PermissionError:
            return

        for i, entry in enumerate(entries):
            is_last = i == len(entries) - 1
            connector = "└── " if is_last else "├── "
            suffix = "/" if entry.is_dir() else ""

            lines.append(f"{prefix}{connector}{entry.name}{suffix}")

            if entry.is_dir():
                new_prefix = prefix + ("    " if is_last else "│   ")
                walk(entry, new_prefix, depth + 1)

    walk(root_path)
    return "\n".join(lines)


def read_file_safe(path: Path, max_chars: int = 12000) -> str:
    try:
        content = path.read_text(encoding="utf-8", errors="ignore")
    except Exception as e:
        return f"[Could not read file: {e}]"

    if len(content) > max_chars:
        content = content[:max_chars] + "\n...[truncated]"

    return content


def _path_tokens(root_path: Path, path: Path):
    rel = str(path.relative_to(root_path)).lower()
    parts = re.split(r"[/_.\\-]+", rel)
    return {p for p in parts if p}


def collect_relevant_files(root: str, keywords=None, max_files: int = 8):
    if keywords is None:
        keywords = []

    root_path = Path(root).resolve()
    candidates = []

    normalized_keywords = []
    for kw in keywords:
        kw = str(kw).strip().lower()
        if kw:
            normalized_keywords.append(kw)

    for path in root_path.rglob("*"):
        if any(part in IGNORED_DIRS for part in path.parts):
            continue
        if not path.is_file():
            continue

        rel = str(path.relative_to(root_path)).lower()
        name = path.name.lower()
        tokens = _path_tokens(root_path, path)

        score = 0

        for kw in normalized_keywords:
            if kw == name:
                score += 8
            if kw in tokens:
                score += 6
            elif kw in rel:
                score += 2

        if "route" in tokens or "routes" in tokens:
            score += 1
        if "js" in tokens or "html" in tokens or "py" in tokens:
            score += 1

        if score > 0:
            candidates.append((score, path))

    candidates.sort(key=lambda x: (-x[0], str(x[1])))

    unique = []
    seen = set()
    for _, path in candidates:
        rel = str(path.relative_to(root_path))
        if rel not in seen:
            seen.add(rel)
            unique.append(path)
        if len(unique) >= max_files:
            break

    return unique
