import json
import subprocess
import time
from pathlib import Path


class OllamaClient:
    def __init__(self, config_path: str = "config.json"):
        self.config_path = Path(config_path)
        self.config = json.loads(self.config_path.read_text(encoding="utf-8"))

        ollama_cfg = self.config.get("ollama", {})
        self.timeout_sec = int(ollama_cfg.get("timeout_sec", 180))
        self.max_retries = int(ollama_cfg.get("max_retries", 3))
        self.base_backoff_sec = int(ollama_cfg.get("base_backoff_sec", 1))

    def get_model(self, role: str) -> str:
        return self.config["models"][role]

    def generate(self, role: str, prompt: str) -> str:
        model = self.get_model(role)
        last_error = None

        for attempt in range(1, self.max_retries + 1):
            print(f"[Ollama] role={role} model={model} attempt={attempt}/{self.max_retries}")
            try:
                result = subprocess.run(
                    ["ollama", "run", model],
                    input=prompt,
                    capture_output=True,
                    text=True,
                    encoding="utf-8",
                    timeout=self.timeout_sec,
                )

                if result.returncode == 0 and result.stdout.strip():
                    return result.stdout.strip()

                stderr = result.stderr.strip() or "Empty stderr"
                stdout = result.stdout.strip() or "Empty stdout"
                last_error = (
                    f"Ollama error for role '{role}' with model '{model}' "
                    f"(attempt {attempt}/{self.max_retries}).\n"
                    f"STDERR:\n{stderr}\n\nSTDOUT:\n{stdout}"
                )

            except subprocess.TimeoutExpired:
                last_error = (
                    f"Ollama timeout for role '{role}' with model '{model}' "
                    f"(attempt {attempt}/{self.max_retries}, timeout={self.timeout_sec}s)."
                )
            except Exception as exc:
                last_error = (
                    f"Unexpected Ollama failure for role '{role}' with model '{model}' "
                    f"(attempt {attempt}/{self.max_retries}): {exc}"
                )

            if attempt < self.max_retries:
                time.sleep(self.base_backoff_sec * (2 ** (attempt - 1)))

        raise RuntimeError(last_error or f"Unknown Ollama failure for role '{role}'")
